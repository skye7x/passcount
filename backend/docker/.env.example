# Copy this file to `.env` and fill in real values. Never commit `.env`.
# (It is already covered by the repo's .gitignore.)

# Root password for the MySQL server (used for admin/maintenance only).
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_please

# Database and application user created automatically on first boot.
MYSQL_DATABASE=passcountdb
MYSQL_USER=passcount_api
MYSQL_PASSWORD=CHANGE_ME_api_please

# Interface the published port binds to.
#   VPS (Azure App Service must reach it) : 0.0.0.0  <-- protect with the
#                                              DOCKER-USER iptables rules
#                                              (see DEPLOYMENT.md)
#   Local dev only                        : 127.0.0.1
MYSQL_BIND_ADDRESS=0.0.0.0

# Port published on the host (Azure connection string must match).
MYSQL_PORT=3306

# Optional: raise if the API needs many concurrent connections.
MYSQL_MAX_CONNECTIONS=150
