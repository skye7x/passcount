# Copy this file to .env.local for local development, or set the same
# variable in your build environment (e.g. as a build-time env var wherever
# you run `npm run build` / `npm run cap:sync` for the mobile app).
#
# This is baked into the static export at build time (it's a NEXT_PUBLIC_
# variable), so the app must be rebuilt whenever this value changes.

# URL of the PassCount backend API (see /backend). No trailing slash.
# Local development (matches backend/README.md's `dotnet run` instructions):
NEXT_PUBLIC_API_URL=http://localhost:5220

# Once deployed, swap in your Azure App Service URL instead, e.g.:
# NEXT_PUBLIC_API_URL=https://passcount-cpd3d6a5d6fpcrgq.polandcentral-01.azurewebsites.net
